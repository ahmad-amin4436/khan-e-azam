<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="KhanEAzam.Admin.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Khan-E-Azam Admin — <asp:ContentPlaceHolder ID="PageTitle" runat="server">Dashboard</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    <style>
        body { background: #f4f6f9; font-family: 'Segoe UI', sans-serif; }
        .sidebar { width: 250px; height: 100vh; background: #1F4D2C; position: fixed; top: 0; left: 0; z-index: 100; display: flex; flex-direction: column; }
        .sidebar .brand { padding: 20px 24px; background: #163820; font-size: 1.1rem; font-weight: 700; color: #F5B82E; letter-spacing: 1px; flex: 0 0 auto; }
        .sidebar nav { flex: 1 1 auto; overflow-y: auto; padding-bottom: 16px; }
        .sidebar nav::-webkit-scrollbar { width: 6px; }
        .sidebar nav::-webkit-scrollbar-thumb { background: #163820; border-radius: 3px; }
        .sidebar nav a { display: block; padding: 12px 24px; color: #c8e6c9; text-decoration: none; font-size: .92rem; border-left: 3px solid transparent; transition: all .2s; }
        .sidebar nav a:hover, .sidebar nav a.active { background: #163820; color: #F5B82E; border-left-color: #F5B82E; }
        .sidebar nav a i { width: 20px; margin-right: 8px; }
        .sidebar nav .nav-section { padding: 10px 24px 4px; font-size: .72rem; text-transform: uppercase; letter-spacing: 1px; color: #81c784; }
        .main-content { margin-left: 250px; min-height: 100vh; }
        .topbar { background: #fff; padding: 12px 28px; border-bottom: 1px solid #dee2e6; display: flex; align-items: center; justify-content: space-between; }
        .topbar .page-heading { font-size: 1.25rem; font-weight: 600; color: #1F4D2C; margin: 0; }
        .topbar .admin-info { font-size: .88rem; color: #555; }
        .content-area { padding: 28px; }
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.07); border-radius: 8px; }
        .card-header { background: #fff; border-bottom: 2px solid #F5B82E; font-weight: 600; color: #1F4D2C; }
        .btn-primary { background: #1F4D2C; border-color: #1F4D2C; }
        .btn-primary:hover { background: #163820; border-color: #163820; }
        .btn-warning { background: #F5B82E; border-color: #F5B82E; color: #1F4D2C; }
        .table thead th { background: #1F4D2C; color: #fff; border: none; }
        .badge-active { background: #28a745; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: .78rem; }
        .badge-inactive { background: #dc3545; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: .78rem; }
        /* Shared filter + sort bar used by the Orders / Quick Requests / Reservations lists */
        .filter-panel { padding: 14px 20px; background: #fbfcfd; border-bottom: 1px solid #e6e9ee; }
        .filter-label { display: block; font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; margin-bottom: 3px; }
        .filter-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
        .sort-bar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .sort-bar .form-control { width: auto; min-width: 130px; }
        .count-pill { background: #1F4D2C; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .75rem; font-weight: 600; margin-left: 8px; }
        /* Sortable GridView headers */
        .table thead th a { color: #fff; text-decoration: none; }
        .table thead th a:hover { color: #F5B82E; text-decoration: none; }
        .sort-indicator { font-size: .7rem; margin-left: 4px; color: #F5B82E; }
        /* ---------- Pager (server-side paging) ---------- */
        .pager-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 20px; border-top: 1px solid #e6e9ee; background: #fbfcfd; }
        .pager-range { font-size: .85rem; color: #4b5563; }
        .pager-range strong { color: #1F4D2C; }
        .pager-controls { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .pager-controls .btn { min-width: 38px; }
        .pager-page { font-size: .85rem; color: #4b5563; padding: 0 6px; white-space: nowrap; }
        .pager-size { display: flex; align-items: center; gap: 6px; }
        .pager-size .form-control { width: auto; }
        .pager-size label { font-size: .78rem; color: #6b7280; margin: 0; white-space: nowrap; }
        @media (max-width: 575.98px) {
            .pager-bar { padding: 10px 12px; justify-content: center; }
            .pager-range { width: 100%; text-align: center; order: -1; }
            .pager-controls, .pager-size { justify-content: center; }
        }
        /* ---------- Responsive admin layout ---------- */
        /* Hamburger + backdrop are desktop-hidden and only appear under 992px. */
        .sidebar-toggle { display: none; background: none; border: 0; color: #1F4D2C; font-size: 1.35rem; line-height: 1; padding: 4px 10px 4px 0; cursor: pointer; }
        .sidebar-toggle:focus { outline: 2px solid #F5B82E; outline-offset: 2px; }
        .sidebar-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 99; }
        .sidebar-backdrop.show { display: block; }
        .topbar .page-heading { overflow-wrap: anywhere; }

        @media (max-width: 991.98px) {
            /* Sidebar slides in over the content instead of reserving 250px. */
            .sidebar { transform: translateX(-100%); transition: transform .25s ease; box-shadow: 2px 0 12px rgba(0,0,0,.25); }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .sidebar-toggle { display: inline-block; }
            .topbar { padding: 10px 16px; gap: 8px; }
            .topbar .page-heading { font-size: 1.05rem; }
            .content-area { padding: 16px; }
            .filter-panel { padding: 12px 16px; }
            /* Sort controls drop below the card title rather than squeezing beside it. */
            .card-header .sort-bar { width: 100%; margin-top: 8px; }
            .sort-bar .form-control { flex: 1 1 auto; min-width: 0; }
        }

        @media (max-width: 575.98px) {
            .topbar .admin-info { font-size: .8rem; }
            .content-area { padding: 12px; }
            .filter-panel { padding: 10px 12px; }
            .filter-actions .btn { flex: 1 1 auto; }
            .filter-actions .text-muted { flex: 1 1 100%; margin-left: 0 !important; }
            .card-header { font-size: .95rem; }
            /* Date range inputs stack so neither is unusably narrow. */
            .filter-panel .d-flex > .form-control { min-width: 0; }
        }

        /* Wide grids scroll horizontally inside the card instead of breaking the page.
           GridView renders a plain <table>, so the wrapper is applied in code-behind. */
        .table-responsive-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table-responsive-wrap > .table { margin-bottom: 0; }
        @media (max-width: 991.98px) {
            .table-responsive-wrap > .table { white-space: nowrap; }
            .table-responsive-wrap > .table td,
            .table-responsive-wrap > .table th { vertical-align: middle; }
        }
    </style>
</head>
<body>
    <form id="frmAdmin" runat="server">
        <div class="sidebar" id="adminSidebar">
            <div class="brand"><i class="fas fa-utensils me-2"></i> Khan-E-Azam</div>
            <nav>
                <% if (CanViewDashboard) { %>
                <div class="nav-section">Main</div>
                <a href="Dashboard.aspx" class='<%= GetActiveClass("Dashboard") %>'><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <% } %>
                <% if (CanManageContent) { %>
                <div class="nav-section">Content</div>
                <a href="BannerSlides.aspx" class='<%= GetActiveClass("BannerSlides") %>'><i class="fas fa-images"></i> Banner Slides</a>
                <a href="BrowseMenu.aspx" class='<%= GetActiveClass("BrowseMenu") %>'><i class="fas fa-hamburger"></i> Browse Menu</a>
                <a href="TodaysSpecials.aspx" class='<%= GetActiveClass("TodaysSpecials") %>'><i class="fas fa-star"></i> Today's Specials</a>
                <a href="MenuFilter.aspx" class='<%= GetActiveClass("MenuFilter") %>'><i class="fas fa-list-ul"></i> Our Menu</a>
                <a href="IconFeatures.aspx" class='<%= GetActiveClass("IconFeatures") %>'><i class="fas fa-icons"></i> Icon Features</a>
                <a href="Chefs.aspx" class='<%= GetActiveClass("Chefs") %>'><i class="fas fa-user-chef"></i> Chefs</a>
                <a href="Testimonials.aspx" class='<%= GetActiveClass("Testimonials") %>'><i class="fas fa-comment-dots"></i> Testimonials</a>
                <a href="BlogPosts.aspx" class='<%= GetActiveClass("BlogPosts") %>'><i class="fas fa-newspaper"></i> Blog Posts</a>
                <% } %>
                <div class="nav-section">Orders</div>
                <a href="Orders.aspx" class='<%= GetActiveClass("Orders") %>'><i class="fas fa-receipt"></i> Manage Orders</a>
                <a href="QuickRequests.aspx" class='<%= GetActiveClass("QuickRequests") %>'><i class="fas fa-phone-volume"></i> Quick Requests</a>
                <a href="TableReservations.aspx" class='<%= GetActiveClass("TableReservations") %>'><i class="fas fa-calendar-check"></i> Table Reservations</a>
                <div class="nav-section">Account</div>
                <% if (IsSuperAdmin) { %>
                <a href="Users.aspx" class='<%= GetActiveClass("Users") %>'><i class="fas fa-user-shield"></i> Admin Users</a>
                <% } %>
                <a href="Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </nav>
        </div>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="main-content">
            <div class="topbar">
                <div class="d-flex align-items-center" style="min-width:0;">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle"
                            aria-label="Toggle navigation" aria-expanded="false" aria-controls="adminSidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-heading"><asp:ContentPlaceHolder ID="PageHeading" runat="server">Dashboard</asp:ContentPlaceHolder></h1>
                </div>
                <span class="admin-info"><i class="fas fa-user-circle me-1"></i> <%= Session["AdminUsername"] ?? "Admin" %></span>
            </div>
            <div class="content-area">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Off-canvas sidebar for narrow screens. Desktop layout is unaffected: the
        // toggle is display:none above 992px and the sidebar is never transformed.
        (function () {
            var sidebar = document.getElementById('adminSidebar');
            var toggle = document.getElementById('sidebarToggle');
            var backdrop = document.getElementById('sidebarBackdrop');
            if (!sidebar || !toggle || !backdrop) return;

            function setOpen(open) {
                sidebar.classList.toggle('open', open);
                backdrop.classList.toggle('show', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            toggle.addEventListener('click', function () {
                setOpen(!sidebar.classList.contains('open'));
            });
            backdrop.addEventListener('click', function () { setOpen(false); });

            // Escape closes it, and following a nav link should not leave it stuck open.
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            sidebar.addEventListener('click', function (e) {
                if (e.target.closest('a')) setOpen(false);
            });
            // Returning to desktop width clears the mobile state.
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) setOpen(false);
            });
        })();
    </script>
    <asp:ContentPlaceHolder ID="Scripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
