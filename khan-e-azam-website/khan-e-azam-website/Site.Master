<script src="/assets/js/jquery.min.js"></script>
	<script src="/assets/vendor/niceselect/js/jquery.nice-select.min.js"></script>
	<script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>
	<script src="/assets/vendor/masonry/masonry-4.2.2.js"></script>
	<script src="/assets/vendor/masonry/isotope.pkgd.min.js"></script>
	<script src="/assets/vendor/particles/particles.js"></script>
	<script src="/assets/vendor/particles/particles-app.js"></script>
	<script src="/assets/js/dz.ajax.js"></script>
	<script src="/assets/js/dz.carousel.js"></script>
	<script src="/assets/js/custom.min.js"></script>
	<script src="/assets/vendor/rangeslider/rangeslider.js"></script>
	<script src="/assets/js/dznav-init.js"></script>
<%--	<script src="/assets/vendor/switcher/switcher.js"></script>--%>
	<script>
		// Ensure the mobile nav toggle works even if jQuery handlers are lost or scripts load differently
		(function(){
			if (typeof document === 'undefined') return;
			document.addEventListener('click', function(e){
				var btn = e.target.closest('.togglebtn');
				if (!btn) return;
				btn.classList.toggle('open');
				var headerNav = document.querySelector('.header-nav');
				if (headerNav) headerNav.classList.toggle('open');
				var backdrop = document.querySelector('.menu-backdrop');
				if (backdrop) backdrop.classList.toggle('show');
				var bar1 = document.querySelector('.bar1');
				var bar2 = document.querySelector('.bar2');
				var bar3 = document.querySelector('.bar3');
				if (bar1) bar1.classList.toggle('rotate1');
				if (bar2) bar2.classList.toggle('opacity0');
				if (bar3) bar3.classList.toggle('rotate2');
				var switchBtn = document.querySelector('.switch-btn');
				if (switchBtn) switchBtn.classList.toggle('hidden');
			});
		})();
	</script>
	<script>
		(function () {
			var loader = document.getElementById('dzPageLoader');
			if (!loader) return;
			var released = false;
			function releaseLoader() {
				if (released) return;
				released = true;
				loader.classList.add('loaded');
			}
			window.addEventListener('load', releaseLoader);
			// Safety net: never let the loader block the page indefinitely
			// (e.g. a slow/hanging resource delaying the window "load" event).
			setTimeout(releaseLoader, 3000);
		})();

		// Fires after every UpdatePanel async postback
		function pageLoad() {
			var loader = document.getElementById('dzPageLoader');
			if (loader) { loader.classList.add('loaded'); }
			// Re-run page-specific post-update logic (e.g. order tracker)
			if (typeof window.keaPostUpdate === 'function') { window.keaPostUpdate(); }
			// Re-bind nav handlers — UpdatePanel replaces DOM so jQuery handlers are lost
			if (typeof jQuery !== 'undefined') {
				jQuery('.togglebtn').off('click.kea').on('click.kea', function () {
					jQuery(this).toggleClass('open');
					jQuery('.header-nav').toggleClass('open');
					jQuery('.menu-backdrop').toggleClass('show');
					jQuery('.bar1').toggleClass('rotate1');
					jQuery('.bar2').toggleClass('opacity0');
					jQuery('.bar3').toggleClass('rotate2');
					jQuery('.switch-btn').toggleClass('hidden');
				});
				jQuery('.menu-backdrop').off('click.kea').on('click.kea', function () {
					jQuery(this).removeClass('show');
					jQuery('.header-nav').removeClass('open');
					jQuery('.togglebtn').removeClass('open');
					jQuery('.bar1').removeClass('rotate1');
					jQuery('.bar2').removeClass('opacity0');
					jQuery('.bar3').removeClass('rotate2');
					jQuery('#drawer1,#drawer2').removeClass('drawer-show');
					jQuery('.contact-sidebar').removeClass('open');
					jQuery('.filter-category-sidebar').removeClass('drawer-show');
					jQuery('body').css({ overflow: 'auto' });
				});
				jQuery('.menu-btn').off('click.kea').on('click.kea', function () {
					jQuery('.contact-sidebar').toggleClass('open');
					jQuery('.menu-backdrop').toggleClass('show');
				});
				jQuery('#kea-theme-toggle').off('click.kea').on('click.kea', function () {
					var html = document.documentElement;
					var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
					if (next === 'light') html.setAttribute('data-theme', 'light');
					else html.removeAttribute('data-theme');
					try { localStorage.setItem('kea_theme', next); } catch (e) {}
				});
				DzCart.badge();
			}
		}
	</script>
	<script>
	/* ===== Khan-E-Azam Cart (localStorage) ===== */
	var DzCartCheckoutUrl = '<%= ResolveUrl("~/Pages/Checkout.aspx") %>';
	var DzCart = {
		KEY: 'kea_cart_v3',
		get: function () { try { return JSON.parse(localStorage.getItem(this.KEY)) || []; } catch(e){ return []; } },
		save: function (items) { localStorage.setItem(this.KEY, JSON.stringify(items)); this.badge(); },
		add: function (id, name, priceStr, image) {
			var items = this.get();
			var numMatch = (priceStr + '').replace(/,/g, '').match(/\d+(\.\d+)?/);
			var price = numMatch ? parseFloat(numMatch[0]) : 0;
			var found = false;
			for (var i = 0; i < items.length; i++) { if (items[i].id === id) { items[i].qty++; found = true; break; } }
			if (!found) items.push({ id: id, name: name, price: price, priceStr: priceStr, image: image, qty: 1 });
			this.save(items);
			this.toast('✓ ' + name + ' added to cart!');
		},
		remove: function (id) { this.save(this.get().filter(function(x){ return x.id !== id; })); },
		setQty: function (id, qty) {
			var items = this.get();
			for (var i = 0; i < items.length; i++) {
				if (items[i].id === id) { if (qty < 1) items.splice(i,1); else items[i].qty = qty; break; }
			}
			this.save(items);
		},
		count: function () { return this.get().reduce(function(s,x){ return s+x.qty; },0); },
		total: function () { return this.get().reduce(function(s,x){ return s+x.price*x.qty; },0); },
		clear: function () { this.save([]); },
		badge: function () {
			var b = document.getElementById('dz-cart-badge');
			var co = document.getElementById('dz-checkout-fab');
			var n = this.count();
			if (b) { b.textContent = n; b.style.display = n > 0 ? 'flex' : 'none'; }
			if (co) { co.style.display = n > 0 ? 'flex' : 'none'; if (n > 0) co.href = DzCartCheckoutUrl; }
		},
		toast: function (msg) {
			var el = document.getElementById('dz-toast');
			if (!el) return;
			el.textContent = msg;
			el.style.opacity = '1'; el.style.transform = 'translateY(0)';
			clearTimeout(el._t);
			el._t = setTimeout(function(){ el.style.opacity='0'; el.style.transform='translateY(16px)'; }, 2500);
		}
	};
	document.addEventListener('DOMContentLoaded', function(){ DzCart.badge(); });
	document.addEventListener('click', function(e){
		var btn = e.target.closest ? e.target.closest('.dz-cart-add') : null;
		if (!btn) return;
		e.preventDefault(); e.stopPropagation();
		DzCart.add(btn.dataset.cartId, btn.dataset.name, btn.dataset.price, btn.dataset.image || '');
	});
	</script>
    </form>
</body>
</html>
