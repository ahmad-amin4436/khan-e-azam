<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="khan_e_azam_website.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Applied before anything paints, so a returning visitor's saved theme choice never
         flashes the wrong theme for a frame. -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('kea_theme');
                if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
            } catch (e) {}
        })();
    </script>
    <title><%: Page.Title %> - Khan E Azam | Restaurant</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="author" content="DEVNET Solutions">
	<meta name="robots" content="">
	<meta name="keywords" content="restaurant, restaurant website templates, restaurant template, food, restro, hotel, tailwind, tailwind css, html, frontend, Khan-E-Azam, responsive template, shop, cart, menu, taste, blog, service, cook, customers, website, hungry, shop cart, fast food, table booking, website templates for restaurants, food website templates">
	<meta name="description" content="Boost your food business with Khan-E-Azam's restaurant website templates. Our professionally designed templates cater specifically to the needs of restaurants, offering visually stunning and functional designs. Choose from a variety of food website templates that are perfect for showcasing your menu, promoting your services, and attracting hungry customers. Partner with DEVNET Solutions to create an impressive online presence for your restaurant. Start driving more traffic and growing your business today.">
	<meta property="og:title" content="Khan-E-Azam - Empowering Your Restaurant Website Templates | DEVNET Solutions | Tailwind">
	<meta property="og:description" content="Boost your food business with Khan-E-Azam's restaurant website templates. Our professionally designed templates cater specifically to the needs of restaurants, offering visually stunning and functional designs. Choose from a variety of food website templates that are perfect for showcasing your menu, promoting your services, and attracting hungry customers. Partner with DEVNET Solutions to create an impressive online presence for your restaurant. Start driving more traffic and growing your business today.">
	<meta property="og:image" content="../Khan-E-Azam.dexignzone.com/tailwind/xhtml/social-home.png">
	<meta name="format-detection" content="telephone=no">
	
	<!-- Mobile Specific -->
	<meta name="viewport" content="width=device-width, initial-scale=1">
    
	<!-- Favicon icon -->
    <link rel="icon" type="image/png" href="/assets/images/favicon.png">

	<!-- Flaticon -->
	<link rel="stylesheet" href="/assets/icons/flaticon/flaticon_swigo.css">

	<!-- Stylesheet -->

	<!-- Swiper -->
	<link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

	<!-- Font Awesome -->
	<link rel="stylesheet" href="/assets/icons/font-awesome/css/all.min.css">

	<!-- Line Awesome -->
	<link rel="stylesheet" href="/assets/icons/line-awesome/css/line-awesome.min.css">

	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com/">
	<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Lobster&amp;family=Lobster+Two:ital,wght@0,400;0,700;1,400;1,700&amp;family=Poppins:ital,wght@0,100;0,200;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&amp;display=swap" rel="stylesheet">
	
	<!-- Custom Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css">
	<link rel="stylesheet" href="/assets/vendor/rangeslider/rangeslider.css">
    <link rel="stylesheet" href="/assets/vendor/switcher/switcher.css">
	<!-- niceSelect JS is loaded sitewide (near the closing </body>) and drives every <select>,
	     but its base CSS was never linked — only style.css's theme OVERRIDES on top of it were,
	     so the dropdown wrapper never got position:relative (or any of its other base structural
	     rules) and its open list fell back to positioning against the nearest positioned ancestor
	     it could find, wherever that happened to be, instead of the dropdown itself. -->
	<link rel="stylesheet" href="/assets/vendor/niceselect/css/nice-select.css">
	<style>
		html { scroll-behavior: smooth; }
		/* Reusable section-spacing classes (style.css is a static precompiled Tailwind build, not
		   a live compiler — large arbitrary-value classes like lg:py-[130px] have no generated CSS
		   and silently no-op). These were previously defined only inside Default.aspx's own scoped
		   scoped style block, so any OTHER page using them (e.g. Reservation.aspx) got zero padding —
		   moved here so every page gets the same guaranteed-working spacing. */
		.sp-y   { padding-top: 45px; padding-bottom: 45px; }
		.sp-t   { padding-top: 45px; }
		.sp-b   { padding-bottom: 45px; }
		.sp-mb  { margin-bottom: 30px; }
		@media (min-width: 1024px) {
			.sp-y  { padding-top: 90px; padding-bottom: 90px; }
			.sp-t  { padding-top: 90px; }
			.sp-b  { padding-bottom: 90px; }
			.sp-mb { margin-bottom: 50px; }
		}
		@media (min-width: 640px) and (max-width: 1023px) {
			.sp-y  { padding-top: 70px; padding-bottom: 70px; }
			.sp-t  { padding-top: 70px; }
			.sp-b  { padding-bottom: 70px; }
			.sp-mb { margin-bottom: 40px; }
		}
		/* ===== Sitewide dark premium theme ===== */
		:root {
			--dark-1: #100C08;    /* base page/section background */
			--dark-2: #17130f;    /* alternating section background */
			--dark-card: #1f1a14; /* card & panel surfaces */
			--dark-border: rgba(255,255,255,0.1);
			--light-text: #f2efe9;
			--muted-text: #b7b0a4;
		}
		/* Light theme: every one of these variables drives the same rules that already paint the
		   whole site (backgrounds, cards, borders, text) — redefining them here re-themes the
		   entire site without touching individual pages. Brand colors (--primary/--secondary/
		   --smoky-black) stay fixed across both themes on purpose; only the neutral surfaces flip. */
		html[data-theme="light"] {
			--dark-1: #FAF7F2;
			--dark-2: #F1EAE0;
			--dark-card: #FFFFFF;
			--dark-border: rgba(16,12,8,0.12);
			--light-text: #1a1611;
			--muted-text: #6b6459;
		}
		/* The twinkling starfield is a dark-theme-only flourish — it reads as noise on a light bg */
		html[data-theme="light"] .kea-stars::before { display: none; }
		html[data-theme="light"] .dz-spinner { border-color: rgba(16,12,8,0.15); border-top-color: var(--primary); }
		body, .page-wraper { background: var(--dark-1) !important; }
		.text-black2 { color: var(--light-text) !important; }
		.text-bodycolor { color: var(--muted-text) !important; }
		/* .alert (used for every inline success/error message on public pages) only sets color
		   via CSS vars — it relies on Bootstrap's "d-block" utility for its own block box, which
		   isn't loaded here, so asp:Label's default inline <span> rendering let these overlap
		   whatever followed them instead of reserving their own space. Fixed once, globally. */
		.alert { display: block !important; width: 100%; box-sizing: border-box; word-wrap: break-word; overflow-wrap: break-word; }
		/* .btn-prev/.btn-next used a pale cream glow (var(--primary-light)) tuned for a white
		   page — on the dark theme it bloomed into a soft halo around the arrow buttons. */
		.btn-next, .btn-prev { box-shadow: 0 6px 16px rgba(0,0,0,0.35) !important; }
		/* The compiled Tailwind "xl:block" utility (display:block) sits later in style.css than
		   the .btn-prev/.btn-next component rule (display:flex) and wins the cascade at desktop
		   widths, so the arrow icon loses its centering and sticks to the top-left of the circle. */
		.btn-next, .btn-prev { display: flex !important; align-items: center !important; justify-content: center !important; }
		/* Menu filter pills (homepage + Menu.aspx) default to near-black text — invisible on dark */
		.filters > li > a { color: var(--light-text) !important; }
		.filters > li.active > a, .filters > li:hover > a { color: var(--secondary) !important; }

		/* Subtle twinkling starfield for the premium dark look — respects reduced-motion.
		   The dot pattern + its opacity animation live on a ::before overlay (z-index:-1),
		   never on the element's own opacity — kea-stars is applied to .page-wraper and to
		   whole page sections, so animating opacity on the element itself faded the entire
		   page/section content in and out every 5s instead of just the decorative dots. */
		.kea-stars { position: relative; }
		.kea-stars::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: -1;
			pointer-events: none;
			/* opacity-only animation so this promotes to its own compositor layer — animating
			   background-position here repainted every kea-stars section on every scroll frame
			   (the homepage alone stacks several of them), which is what made scrolling feel janky. */
			will-change: opacity;
			background-image:
				radial-gradient(1.4px 1.4px at 10% 20%, rgba(255,255,255,0.85), transparent 60%),
				radial-gradient(1px 1px at 30% 75%, rgba(255,255,255,0.6), transparent 60%),
				radial-gradient(1.4px 1.4px at 52% 35%, rgba(255,210,0,0.55), transparent 60%),
				radial-gradient(1px 1px at 74% 85%, rgba(255,255,255,0.7), transparent 60%),
				radial-gradient(1.4px 1.4px at 92% 15%, rgba(255,255,255,0.5), transparent 60%),
				radial-gradient(1px 1px at 15% 92%, rgba(255,210,0,0.4), transparent 60%),
				radial-gradient(1.4px 1.4px at 86% 55%, rgba(255,255,255,0.6), transparent 60%);
			background-repeat: repeat;
			background-size: 340px 220px;
			animation: kea-twinkle 5s ease-in-out infinite alternate;
		}
		@keyframes kea-twinkle {
			0%   { opacity: 0.55; }
			50%  { opacity: 0.9; }
			100% { opacity: 0.6; }
		}
		@media (prefers-reduced-motion: reduce) {
			.kea-stars::before { animation: none; opacity: 0.7; }
		}
		body.kea-stars, .page-wraper.kea-stars { background-color: var(--dark-1); }

		/* Page loader */
		@keyframes dz-spin { to { transform: rotate(360deg); } }
		.dz-spinner { width:44px; height:44px; border-radius:50%; border:4px solid rgba(255,255,255,0.25); border-top-color:#fff; animation:dz-spin .65s linear infinite; margin-top:18px; }
		#dzPageLoader { transition:opacity .35s ease, visibility .35s ease; }
		#dzPageLoader.loaded { opacity:0; visibility:hidden; pointer-events:none; }
		/* Header utility icons */
		.header-icon-link { color:#fff; font-size:18px; opacity:.85; transition:opacity .2s, color .2s; }
		.header-icon-link:hover { opacity:1; color:var(--secondary); }
		/* Light/dark theme toggle */
		.kea-theme-toggle {
			width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
			background: var(--dark-card); border: 1px solid var(--dark-border); color: var(--light-text);
			cursor: pointer; transition: background .2s, transform .2s; flex-shrink: 0; font-size: 15px;
		}
		.kea-theme-toggle:hover { transform: scale(1.08); color: var(--secondary); }
		.kea-theme-toggle .kea-theme-icon-light { display: none; }
		html[data-theme="light"] .kea-theme-toggle .kea-theme-icon-dark { display: none; }
		html[data-theme="light"] .kea-theme-toggle .kea-theme-icon-light { display: block; }
		/* Fallback rules for Tailwind arbitrary-value classes not present in the precompiled style.css */
		.bg-\[\#ffffff1a\] { background-color: #ffffff1a; }
		/* mb-[20px]/mt-[40px] have no generated CSS either — used across several form field rows
		   and CTA buttons (Quick Order Request, Table Reservation, etc.), so those all silently
		   lost their spacing. Global fallback fixes every current and future use at once. */
		.mb-\[20px\] { margin-bottom: 20px; }
		.mt-\[40px\] { margin-top: 40px; }
		.rounded-\[16px\] { border-radius: 16px; }
		/* Header: a separate, elegant bar — not a transparent overlay on the hero. Uses the same
		   theme variables as the rest of the page, so it flips with the light/dark toggle too. */
		.site-header { position: sticky !important; top: 0; background: var(--dark-1); z-index: 999; }
		.site-header.is-fixed { background: var(--dark-1) !important; box-shadow: 0 4px 20px rgba(0,0,0,0.25); }
		.main-bar .header-nav .navbar > li > a { color: var(--light-text) !important; }
		/* The footer card used the template's flat gray (#222) instead of the page's actual dark
		   background, so it read as a separate floating panel rather than the page continuing. */
		.footer-bg-wrapper.bg-black2 { background-color: var(--dark-1) !important; }
		/* .site-footer itself has no background — it's transparent around the inset rounded card
		   (the mx-[100px] gutters either side), so .page-wraper's kea-stars twinkle layer behind
		   it showed through as loose dots floating in that margin. Opaque match hides it. */
		.site-footer { background-color: var(--dark-1); }
		/* The footer's own text/icons were hardcoded for a permanently-dark footer (text-white,
		   #CCCCCC links, a #ffffff1a highlight circle) — now that its background follows the
		   theme too, those same hardcoded colors wash out to near-invisible in light mode. */
		.site-footer .text-white { color: var(--light-text) !important; }
		.site-footer .widget_getintuch ul li p,
		.site-footer .widget_services ul li,
		.site-footer .widget_services ul li a { color: var(--muted-text) !important; }
		.site-footer .widget_services ul li a:hover { color: var(--primary) !important; }
		html[data-theme="light"] .site-footer .bg-\[\#ffffff1a\] { background-color: rgba(16,12,8,0.06) !important; }
		html[data-theme="light"] .site-footer .border-\[\#ffffff1a\] { border-color: rgba(16,12,8,0.12) !important; }
		.main-bar .header-nav .navbar > li.active > a,
		.main-bar .header-nav .navbar > li:hover > a { color: var(--secondary) !important; }
		.main-bar { padding-top: 10px; padding-bottom: 10px; }
		/* Mobile nav drawer defaults to a white panel — the nav links above are forced white
		   for the dark desktop header, which made them invisible (white-on-white) on mobile. */
		@media (max-width: 991px) {
			.main-bar .header-nav { background-color: var(--dark-card) !important; box-shadow: 4px 0 30px rgba(0,0,0,0.4); }
			.main-bar .header-nav .navbar > li { border-bottom-color: var(--dark-border) !important; }
		}
		@media (min-width: 768px) { .main-bar { padding-top: 22px; padding-bottom: 22px; } }
		/* Footer: keep widget icons aligned with their text regardless of how many lines it wraps to.
		   .widget_getintuch ul li i is position:absolute in the base stylesheet, which takes it out
		   of flex flow entirely — the earlier flex/gap rule here never actually reached it, so the
		   icon stayed pinned at its old fixed left/top while the text (a real flex item) moved,
		   drifting apart. Un-absolving it so both are laid out by the same flex row. */
		.widget_getintuch ul li, .widget_services ul li { display: flex !important; align-items: flex-start; gap: 12px; padding-left: 0 !important; }
		.widget_getintuch ul li i, .widget_services ul li i { position: static !important; flex-shrink: 0; margin-top: 4px; width: auto; height: auto; }
		.widget_getintuch ul li p, .widget_services ul li p { margin: 0; }
		/* Contact sidebar */
		#contactDrawer { position:fixed; top:0; left:-300px; width:300px; height:100%; z-index:999999; background:var(--dark-card); overflow-y:auto; transition:left .5s ease; padding:30px; border-right:1px solid var(--dark-border); }
		#contactDrawer.open { left:0; }
		#contactDrawer .contact-text p, #contactDrawer .icon-content p { color:var(--muted-text); }
		#contactDrawer .icon-content h6.tilte { color:var(--light-text); }
		/* FABs — a soft neutral shadow reads fine on both the light pages and the dark homepage;
		   the old per-button colored glow (esp. WhatsApp's green) bloomed into a visible smear
		   once the homepage background went dark, so it's replaced with one consistent shadow. */
		.dz-fab-stack { position:fixed; bottom:24px; right:24px; z-index:99998; display:flex; flex-direction:column-reverse; align-items:center; gap:12px; }
		.dz-fab { width:54px; height:54px; border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none; box-shadow:0 6px 16px rgba(0,0,0,.3); transition:transform .2s, box-shadow .2s; border:1px solid rgba(255,255,255,0.12); }
		.dz-fab:hover { transform:scale(1.08); box-shadow:0 8px 22px rgba(0,0,0,.4); }
		.dz-fab-wa { background:#25D366; }
		.dz-fab-cart { background:var(--primary); position:relative; }
		/* Fixed brand-dark background (not the theme-toggling --dark-card) — these two carry a
		   hardcoded white icon, so in light mode --dark-card (now white) made the icon invisible. */
		.dz-fab-call { background: #100C08; border-color: rgba(255,255,255,0.25); }
		.dz-fab-checkout { background: #100C08; border-color: rgba(255,255,255,0.25); }
		#dz-cart-badge { position:absolute; top:-4px; right:-4px; background:var(--accent-red); color:#fff; font-size:11px; font-weight:700; min-width:20px; height:20px; border-radius:10px; display:none; align-items:center; justify-content:center; padding:0 4px; }
		#dz-toast { position:fixed; bottom:110px; right:24px; background:rgba(30,30,30,.92); color:#fff; padding:10px 18px; border-radius:8px; font-size:13px; z-index:999999; opacity:0; transform:translateY(16px); transition:opacity .3s, transform .3s; pointer-events:none; max-width:260px; }
	</style>
</head>
<body id="bg" class="box-border m-0 selection:bg-primary selection:text-white font-poppins">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>
        <asp:UpdatePanel ID="upMain" runat="server" UpdateMode="Conditional">
            <ContentTemplate> 
              
	<!-- Pointer ring -->


	<div class="page-wraper kea-stars">
	

	<!-- Header -->
	<header class="site-header main-bar-wraper top-0 left-0 w-full z-[999]">
		<div class="main-bar md:py-[15px] py-[5px]">
			<div class="container-fluid px-[90px] max-xl:px-[15px] relative flex justify-between">
				<!-- Website Logo -->
				<div class="logo-header w-[180px] h-[64px] items-center relative flex">
					<a runat="server" href="Default.aspx" class="">
						<img runat="server" src="~/assets/images/logo2.png" alt="/">
					</a>
				</div>
				
				<!-- Utility controls: theme toggle (always visible) + mobile menu toggle -->
				<div class="flex items-center" style="gap:12px;">
					<button type="button" id="kea-theme-toggle" class="kea-theme-toggle" title="Switch light/dark theme" aria-label="Switch light and dark theme">
						<i class="fa-solid fa-sun kea-theme-icon-light"></i>
						<i class="fa-solid fa-moon kea-theme-icon-dark"></i>
					</button>
					<button type="button" class="togglebtn lg:hidden block bg-primary w-[45px] h-[45px] relative rounded-md">
						<div class="bar1"></div>
						<div class="bar2"></div>
						<div class="bar3"></div>
					</button>
				</div>

				<!-- Header Nav -->
				<div class="header-nav lg:justify-end lg:grow lg:flex-row flex-col lg:gap-0 gap-5 flex lg:relative">
					<div class="logo-header lg:hidden">
						<a runat="server" href="Default.aspx" class="">
							<img runat="server" src="~/assets/images/logo2.png" alt="/">
						</a>
					</div>
					<ul class="nav navbar-nav navbar lg:flex items-center">

						<li>
							<a runat="server" href="Default.aspx">Home</a>
						</li>
                        	<li>
							<a runat="server" href="about.aspx">About Us</a>
						</li>
                        	<li>
							<a runat="server" href="~/Pages/Menu.aspx">Menu</a>
						</li>
                        	<li>
							<a runat="server" href="~/Pages/OrderTracking.aspx">Order Tracking</a>
						</li>
                        	<li>
							<a runat="server" href="Reservation.aspx">Reservation</a>
						</li>
                        	<li>
							<a runat="server" href="contact.aspx">Contact Us</a>
						</li>

					</ul>
				</div>
			</div>
		</div>
	</header>
	<!-- Header -->

	<!-- Contact Sidebar -->
	<div id="contactDrawer" class="contact-sidebar">
		<div class="contact-box">
			<div class="logo-contact mb-[30px] h-[65px]">
				<a runat="server" href="Default.aspx" class="">
					<img runat="server" src="~/assets/images/logo2.png" alt="/" class="">
				</a>
			</div>
			<div class="mb-[50px] contact-text">
				<div class="title text-black2 mb-[12px]">
					<h4 class="text-2xl">About Us</h4>
				</div>
				<p class="mb-4 text-lg">Luxury dining with rooftop &mdash; every dish at Khan-e-Azam is prepared using hand-picked, authentic ingredients and time-honoured recipes.</p>
				<a href="about.aspx" class="btn btn-primary btn-hover-2"><span>READ MORE</span></a>
			</div>
			<div class="title  text-black2">
				<h4 class="mb-5">Contact Info</h4>
			</div>
			<div class="icon-bx-wraper relative mb-5">
				<div class="icon-md">
					<span class="icon-cell">
						<i class="las la-map-marker text-2xl"></i>
					</span>
				</div>
				<div class="icon-content">
					<h6 class="tilte mb-[5px]">Location</h6>
					<p>880 N Poonch Rd, Samanabad Town, Lahore, Punjab 54000, Pakistan</p>
				</div>
			</div>
			<div class="icon-bx-wraper relative mb-5">
				<div class="icon-md">
					<span class="icon-cell">
						<i class="las la-envelope-open text-2xl"></i>
					</span>
				</div>
				<div class="icon-content">
					<h6 class="tilte mb-[5px]">Email Now</h6>
					<p>khaneazamrestaurant@gmail.com</p>
				</div>
			</div>
			<div class="icon-bx-wraper relative mb-5">
				<div class="icon-md">
					<span class="icon-cell"><i class="las la-phone-volume text-2xl"></i></span>
				</div>
				<div class="icon-content">
					<h6 class="tilte mb-[5px]">Call Now</h6>
					<p>0308-9406789</p>
				</div>
			</div>
		</div>
	</div>
        
