        </asp:UpdatePanel>

	<!-- These elements are OUTSIDE UpdatePanel — postbacks never reset them -->
	<div id="dzPageLoader" class="loading-page-2 fixed top-0 left-0 w-full h-full z-[999999999] flex flex-col items-center justify-center bg-primary">
		<img src="/assets/images/favicon.png" alt="Khan-E-Azam" style="width:72px;height:72px;object-fit:contain;">
		<div class="dz-spinner"></div>
	</div>
	
